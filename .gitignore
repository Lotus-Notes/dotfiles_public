# Neovim plugins (never commit these)
nvim/.config/nvim/pack/
nvim/.local/share/nvim/
nvim/.cache/

# Generic plugin dirs if you ever have them
**/pack/
**/site/
**/start/
**/opt/


# Backup files
*.bak
*.swp
*.swo
*~

# Python virtual environments
venv/
.venv/
__pycache__/
*.pyc

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Application caches and logs
.cache/
*.log

# OS-generated files
.DS_Store
Thumbs.db
