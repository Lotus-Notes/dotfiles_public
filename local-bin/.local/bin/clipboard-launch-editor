#!/bin/bash

# Launch the default editor (port of omarchy-launch-editor).
# Usage: clipboard-launch-editor [--inline] <path>
# Omarchy reads the editor from ~/.local/state/omarchy/defaults/editor, which is
# unset on a default install, so nvim. Set CLIPBOARD_EDITOR to pick another.

BIN=$(dirname "$(readlink -f "$0")")

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

editor="${CLIPBOARD_EDITOR:-nvim}"

command -v "$editor" >/dev/null || editor="nvim"

# Omarchy launches apps through uwsm; do the same only when this compositor
# session is actually managed by uwsm (installed is not enough).
uwsm=()
command -v uwsm >/dev/null && uwsm check is-active >/dev/null 2>&1 && uwsm=(uwsm-app --)

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    exec "$BIN/clipboard-launch-tui" "$editor" -- "$@"
  fi
  ;;
*)
  exec setsid "${uwsm[@]}" "$editor" -- "$@"
  ;;
esac
